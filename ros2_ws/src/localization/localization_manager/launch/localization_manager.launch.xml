<launch>

  <arg name="localization_manager_param" default="$(find-pkg-share localization_manager)/config/localization_manager.param.yaml"/>
  <arg name="localization_trigger_topic" default="/localization/trigger"/>
  <arg name="localization_trigger_service" default="/trigger_grid_search_localization"/>
  <arg name="localization_result_topic" default="/localization_result"/>
  <arg name="localization_feedback_timeout_sec" default="0.0"/>
  <arg name="use_amcl_pose" default="false"/>
  <arg name="amcl_pose_topic" default="/amcl_pose"/>
  <arg name="amcl_pose_max_xy_variance" default="-1.0"/>
  <arg name="amcl_pose_max_yaw_variance" default="-1.0"/>
  <arg name="publish_initialpose_to_amcl" default="false"/>
  <arg name="initial_pose_topic" default="/initialpose"/>
  <arg name="use_sim_time" default="false"/>

  <arg name="publish_localization_tf" default="true"/>
  <arg name="localization_tf_mode" default="map_to_odom"/>
  <arg name="localization_tf_map_frame" default="map"/>
  <arg name="localization_tf_odom_frame" default="odom"/>
  <arg name="localization_tf_base_frame" default="base_link"/>
  <arg name="localization_tf_publish_rate_hz" default="20.0"/>

  <node pkg="localization_manager"
        exec="localization_manager_node"
        name="localization_manager_node"
        output="screen">
    <param from="$(var localization_manager_param)"/>
    <param name="localization_trigger_topic" value="$(var localization_trigger_topic)"/>
    <param name="localization_trigger_service" value="$(var localization_trigger_service)"/>
    <param name="localization_result_topic" value="$(var localization_result_topic)"/>
    <param name="localization_feedback_timeout_sec" value="$(var localization_feedback_timeout_sec)"/>
    <param name="use_amcl_pose" value="$(var use_amcl_pose)"/>
    <param name="amcl_pose_topic" value="$(var amcl_pose_topic)"/>
    <param name="amcl_pose_max_xy_variance" value="$(var amcl_pose_max_xy_variance)"/>
    <param name="amcl_pose_max_yaw_variance" value="$(var amcl_pose_max_yaw_variance)"/>
    <param name="publish_initialpose_to_amcl" value="$(var publish_initialpose_to_amcl)"/>
    <param name="initial_pose_topic" value="$(var initial_pose_topic)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="publish_localization_tf" value="$(var publish_localization_tf)"/>
    <param name="localization_tf_mode" value="$(var localization_tf_mode)"/>
    <param name="localization_tf_map_frame" value="$(var localization_tf_map_frame)"/>
    <param name="localization_tf_odom_frame" value="$(var localization_tf_odom_frame)"/>
    <param name="localization_tf_base_frame" value="$(var localization_tf_base_frame)"/>
    <param name="localization_tf_publish_rate_hz" value="$(var localization_tf_publish_rate_hz)"/>
  </node>

</launch>

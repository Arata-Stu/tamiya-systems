<launch>
    <arg name="vehicle_control_topic" default="/jetracer/control_cmd"/>
    <arg name="jetracer_param" default="$(find-pkg-share jetracer_driver)/config/jetracer_node.param.yaml"/>

    <arg name="publish_tf" default="true"/>
    <arg name="robot_description_xacro" default="$(find-pkg-share jetracer_driver)/urdf/jetracer_sensor_kit.urdf.xacro"/>
    <arg name="base_frame" default="base_link"/>
    <arg name="lidar_frame" default="laser"/>
    <arg name="camera_frame" default="camera_camera_link"/>
    <arg name="publish_camera_stereo_tf" default="false"/>

    <!-- Sensor offsets are defined from rear axle center (base_link), unit: [m] -->
    <arg name="lidar_x" default="0.2725"/>
    <arg name="lidar_y" default="0.0"/>
    <arg name="lidar_z" default="0.0257"/>
    <arg name="lidar_roll" default="0.0"/>
    <arg name="lidar_pitch" default="0.0"/>
    <arg name="lidar_yaw" default="0.0"/>

    <!-- Camera mount (screw) offset from rear axle center (base_link), unit: [m] -->
    <arg name="camera_x" default="0.2075"/>
    <arg name="camera_y" default="0.019"/>
    <arg name="camera_z" default="0.065"/>
    <arg name="camera_roll" default="0.0"/>
    <arg name="camera_pitch" default="0.0"/>
    <arg name="camera_yaw" default="0.0"/>
    <arg name="camera_interocular" default="0.05"/>
    <!-- Offset from camera mount (screw) to stereo lens center (camera frame), unit: [m] -->
    <arg name="camera_mount_to_lens_x" default="0.0"/>
    <arg name="camera_mount_to_lens_y" default="-0.0075"/>
    <arg name="camera_mount_to_lens_z" default="0.0"/>

    <let
      name="robot_description"
      value="$(command 'xacro $(var robot_description_xacro) base_frame:=$(var base_frame) lidar_frame:=$(var lidar_frame) camera_frame:=$(var camera_frame) publish_camera_stereo_tf:=$(var publish_camera_stereo_tf) lidar_x:=$(var lidar_x) lidar_y:=$(var lidar_y) lidar_z:=$(var lidar_z) lidar_roll:=$(var lidar_roll) lidar_pitch:=$(var lidar_pitch) lidar_yaw:=$(var lidar_yaw) camera_x:=$(var camera_x) camera_y:=$(var camera_y) camera_z:=$(var camera_z) camera_roll:=$(var camera_roll) camera_pitch:=$(var camera_pitch) camera_yaw:=$(var camera_yaw) camera_interocular:=$(var camera_interocular) camera_mount_to_lens_x:=$(var camera_mount_to_lens_x) camera_mount_to_lens_y:=$(var camera_mount_to_lens_y) camera_mount_to_lens_z:=$(var camera_mount_to_lens_z)')"/>

    <node pkg="jetracer_driver"
          exec="jetracer_node.py"
          name="jetracer_node"
          output="screen">
        <param from="$(var jetracer_param)"/>
        <remap from="/control_cmd" to="$(var vehicle_control_topic)"/>
    </node>

    <group if="$(var publish_tf)">
        <node pkg="robot_state_publisher"
              exec="robot_state_publisher"
              name="robot_state_publisher"
              output="screen">
            <param name="robot_description" value="$(var robot_description)"/>
            <param name="use_tf_static" value="true"/>
        </node>
    </group>
</launch>

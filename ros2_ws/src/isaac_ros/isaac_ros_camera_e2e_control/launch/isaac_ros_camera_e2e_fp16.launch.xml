<?xml version="1.0"?>
<launch>
    <include file="$(find-pkg-share isaac_ros_camera_e2e_control)/launch/isaac_ros_camera_e2e.launch.xml">
        <!-- Camera encoder path remains f32; Triton output/decoder path is switched to fp16 -->
        <arg name="triton_input_tensor_format" value="nitros_tensor_list_nchw_rgb_f32" />
        <arg name="triton_output_tensor_format" value="nitros_tensor_list_nhwc_rgb_f16" />
        <arg name="decoder_input_tensor_format" value="nitros_tensor_list_nhwc_rgb_f16" />
        <arg name="decoder_tensor_data_type" value="fp16" />
    </include>
</launch>

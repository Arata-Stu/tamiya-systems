<launch>
  <arg name="ftg_controller_param"
       default="$(find-pkg-share ftg_controller)/config/control/ftg_controller.param.yaml"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="drive_topic" default="/autonomous/cmd_drive"/>
  <arg name="velocity_topic" default="/current_velocity"/>

  <arg name="container_name" default="lidar_container"/>
  <arg name="create_container" default="false"/>

  <group if="$(var create_container)">
    <node pkg="rclcpp_components"
          exec="component_container"
          name="$(var container_name)"
          output="screen"/>
  </group>

  <load_composable_node target="$(var container_name)">
    <composable_node pkg="ftg_controller"
                     plugin="ftg_controller::FtgControllerComponent"
                     name="ftg_controller_node">
      <param from="$(var ftg_controller_param)"/>
      <remap from="scan" to="$(var scan_topic)"/>
      <remap from="autonomous/cmd_drive" to="$(var drive_topic)"/>
      <remap from="current_velocity" to="$(var velocity_topic)"/>
    </composable_node>
  </load_composable_node>
</launch>

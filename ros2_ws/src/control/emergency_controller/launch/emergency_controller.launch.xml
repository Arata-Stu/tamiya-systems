<launch>
  <arg name="emergency_controller_param"
       default="$(find-pkg-share emergency_controller)/config/emergency_controller.param.yaml"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="input_drive_topic" default="/autonomous/cmd_drive"/>
  <arg name="output_drive_topic" default="/emergency/cmd_drive"/>
  <arg name="signal_topic" default="/emergency/signal"/>

  <node pkg="emergency_controller"
        exec="emergency_controller_node"
        name="emergency_controller_node"
        output="screen">
    <param from="$(var emergency_controller_param)"/>
    <remap from="scan" to="$(var scan_topic)"/>
    <remap from="input/cmd_drive" to="$(var input_drive_topic)"/>
    <remap from="emergency/cmd_drive" to="$(var output_drive_topic)"/>
    <remap from="emergency/signal" to="$(var signal_topic)"/>
  </node>
</launch>

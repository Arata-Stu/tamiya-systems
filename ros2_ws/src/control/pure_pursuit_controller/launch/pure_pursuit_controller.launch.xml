<launch>
  <arg name="pure_pursuit_controller_param"
       default="$(find-pkg-share pure_pursuit_controller)/config/pure_pursuit_controller.param.yaml"/>
  <arg name="trajectory_topic" default="/autonomous/trajectory"/>
  <arg name="drive_topic" default="/autonomous/cmd_drive"/>
  <arg name="velocity_topic" default="/current_velocity"/>
  <arg name="odometry_topic" default="/visual_slam/tracking/odometry"/>

  <node pkg="pure_pursuit_controller"
        exec="pure_pursuit_controller_node"
        name="pure_pursuit_controller_node"
        output="screen">
    <param from="$(var pure_pursuit_controller_param)"/>
    <remap from="trajectory" to="$(var trajectory_topic)"/>
    <remap from="autonomous/cmd_drive" to="$(var drive_topic)"/>
    <remap from="current_velocity" to="$(var velocity_topic)"/>
    <remap from="odometry" to="$(var odometry_topic)"/>
  </node>
</launch>

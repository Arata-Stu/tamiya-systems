<launch>

  <arg name="teleop_param"  default="$(find-pkg-share teleop_manager)/config/teleop.param.yaml"/>
  <arg name="autonomous_control_topic" default="/autonomous/cmd_drive"/>
  <arg name="emergency_control_topic" default="/emergency/cmd_drive"/>
  <arg name="emergency_signal_topic" default="/emergency/signal"/>
  <arg name="vehicle_control_topic" default="/jetracer/cmd_drive"/>
  <arg name="trigger_topic" default="/rosbag2_recorder/trigger"/>
  <arg name="memo_topic" default="/rosbag2_recorder/memo"/>
  <arg name="localization_trigger_service" default="/trigger_grid_search_localization"/>
  <arg name="localization_feedback_topic" default="/localization_result"/>
  <arg name="localization_feedback_timeout_sec" default="0.0"/>

  
  <!-- joynode -->
  <node pkg="joy" 
        exec="joy_node"
        name="joy_node"
        output="screen">
    <param name="deadzone" value="0.05"/>
  </node>

  <!-- joy manager node-->
  <node pkg="teleop_manager"
        exec="teleop_manager_node"
        name="teleop_manager_node"
        output="screen">
        
    <param from="$(var teleop_param)"/>
    <param name="localization_feedback_topic" value="$(var localization_feedback_topic)"/>
    <param name="localization_feedback_timeout_sec" value="$(var localization_feedback_timeout_sec)"/>
    <!-- joy -->
    <remap from="/joy" to="/joy"/>
    <!-- AI制御コマンド -->
    <remap from="autonomous/cmd_drive" to="$(var autonomous_control_topic)"/>
    <!-- 緊急オーバライド制御コマンド -->
    <remap from="emergency/cmd_drive" to="$(var emergency_control_topic)"/>
    <!-- 緊急オーバライド信号 -->
    <remap from="emergency/signal" to="$(var emergency_signal_topic)"/>
    <!-- RCカーへの入力 -->
    <remap from="cmd_drive" to="$(var vehicle_control_topic)"/> 
    <!-- rosbag制御トリガ -->
    <remap from="/rosbag2_recorder/trigger" to="$(var trigger_topic)"/>
    <!-- rosbagメモ -->
    <remap from="/rosbag2_recorder/memo" to="$(var memo_topic)"/>
    <!-- localizationトリガサービス -->
    <remap from="trigger_grid_search_localization" to="$(var localization_trigger_service)"/>
  </node>

</launch>

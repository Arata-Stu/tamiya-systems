<launch>
    <arg name="use_lidar" default="true" description="use lidar"/>
    <arg name="lidar_model" default="hokuyo" />
    <arg name="lidar_container_name" default="lidar_container" />
    <arg name="create_lidar_container" default="true" />
    <arg name="filter_param" default="$(find-pkg-share sensor_kit_launch)/config/lidar/scan_filter_footprint_angle.param.yaml" />
         
    <arg name="use_camera" default="true" description="use camera"/>
    <arg name="camera_model" default="realsense" />
    <arg name="camera_container_name" default="camera_container" />
    <arg name="create_camera_container" default="true" />
    <arg name="image_width" default="424" />
    <arg name="image_height" default="240" />
    <arg name="image_fps" default="90.0" />

    <!-- Lidar Nodes -->
    <group if="$(var use_lidar)">
        <include file="$(find-pkg-share sensor_kit_launch)/launch/lidar/lidar.launch.xml">
            <arg name="lidar_model" value="$(var lidar_model)"/>    
            <arg name="lidar_container_name" value="$(var lidar_container_name)"/>
            <arg name="create_container" value="$(var create_lidar_container)"/>
            <arg name="filter_param" value="$(var filter_param)"/>
        </include>
    </group>

    <!-- Camera Nodes -->
    <group if="$(var use_camera)">
        <include file="$(find-pkg-share sensor_kit_launch)/launch/camera/camera.launch.xml">
            <arg name="camera_model" value="$(var camera_model)"/>    
            <arg name="camera_container_name" value="$(var camera_container_name)"/>
            <arg name="create_container" value="$(var create_camera_container)"/>
            <arg name="image_width" value="$(var image_width)"/>
            <arg name="image_height" value="$(var image_height)"/>
            <arg name="image_fps" value="$(var image_fps)"/>
        </include>
    </group>
</launch>

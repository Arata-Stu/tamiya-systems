<launch>
    <arg name="lidar_container_name" default="lidar_container" />
    <arg name="filter_param" default="$(find-pkg-share sensor_kit_launch)/config/lidar/scan_filter_footprint_angle.param.yaml" />

    <load_composable_node target="$(var lidar_container_name)">
        <composable_node pkg="ydlidar_ros2_driver" plugin="ydlidar_ros2_driver::YdlidarRos2DriverComponent" name="ydlidar_ros2_driver_node">
            <param from="$(find-pkg-share sensor_kit_launch)/config/lidar/t_mini_plus.param.yaml"/>
            <remap from="scan" to="scan_raw"/>
        </composable_node>
    </load_composable_node>

    <load_composable_node target="$(var lidar_container_name)">
        <composable_node
            pkg="laser_filters"
            plugin="ScanToScanFilterChain"
            name="laser_filter_node">
            <param from="$(var filter_param)"/>
            <remap from="scan" to="scan_raw"/>
            <remap from="scan_filtered" to="scan"/>
        </composable_node>
    </load_composable_node>
</launch>

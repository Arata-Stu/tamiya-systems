<launch>
    <arg name="use_camera" default="true" description="use camera"/>
    <arg name="camera_model" default="realsense" />
    <arg name="camera_container_name" default="camera_container" />
    <arg name="create_container" default="true" />

    <arg name="image_width" default="424" />
    <arg name="image_height" default="240" />
    <arg name="image_fps" default="90.0" />
    <arg name="camera_mount_frame" default="camera_link" />
    <arg name="realsense_base_frame" default="camera_camera_link" />
    <arg name="publish_realsense_mount_tf" default="true" />
    <arg name="publish_vslam_optical_alias_tf" default="false" />

    <node pkg="rclcpp_components" exec="component_container_mt" name="$(var camera_container_name)" output="screen"
          if="$(var create_container)"/>

    <group if="$(eval '\'$(var use_camera)\' == \'true\' and \'$(var camera_model)\' == \'realsense\'')">
        <include file="$(find-pkg-share sensor_kit_launch)/launch/camera/realsense.launch.xml">
            <arg name="camera_container_name" value="$(var camera_container_name)"/>
            <arg name="image_width" value="$(var image_width)"/>
            <arg name="image_height" value="$(var image_height)"/>
            <arg name="image_fps" value="$(var image_fps)"/>
            <arg name="camera_mount_frame" value="$(var camera_mount_frame)"/>
            <arg name="realsense_base_frame" value="$(var realsense_base_frame)"/>
            <arg name="publish_realsense_mount_tf" value="$(var publish_realsense_mount_tf)"/>
            <arg name="publish_vslam_optical_alias_tf" value="$(var publish_vslam_optical_alias_tf)"/>
        </include>
    </group>

    <group if="$(eval '\'$(var use_camera)\' == \'true\' and \'$(var camera_model)\' == \'elp\'')">
        <include file="$(find-pkg-share sensor_kit_launch)/launch/camera/elp.launch.xml">
            <arg name="camera_container_name" value="$(var camera_container_name)"/>
            <arg name="image_width" value="$(var image_width)"/>
            <arg name="image_height" value="$(var image_height)"/>
            <arg name="image_fps" value="$(var image_fps)"/>
        </include>
    </group>

    <group if="$(eval '\'$(var use_camera)\' == \'true\' and \'$(var camera_model)\' not in [\'realsense\', \'elp\']')">
        <include file="$(find-pkg-share sensor_kit_launch)/launch/camera/$(var camera_model).launch.xml">
            <arg name="camera_container_name" value="$(var camera_container_name)"/>
            <arg name="image_width" value="$(var image_width)"/>
            <arg name="image_height" value="$(var image_height)"/>
            <arg name="image_fps" value="$(var image_fps)"/>
        </include>
    </group>
</launch>

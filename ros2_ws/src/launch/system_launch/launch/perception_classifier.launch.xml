<launch>
  <arg name="classifier_decoder_param"
       default="$(find-pkg-share system_launch)/config/perception/scan_image_classifier_decoder.param.yaml" />
  <arg name="input_image_topic" default="/perception/crop/image" />
  <arg name="input_camera_info_topic" default="/perception/crop/camera_info" />
  <arg name="input_image_width" default="64" />
  <arg name="input_image_height" default="64" />
  <arg name="network_image_width" default="64" />
  <arg name="network_image_height" default="64" />
  <arg name="model_repository_path" default="/workspaces/isaac_ros_assets/models/" />
  <arg name="model_name" default="scan_image_classifier" />
  <arg name="use_rgb_format_converter" default="true" />
  <arg name="rgb_image_topic" default="/perception/classifier/image_rgb" />
  <arg name="tensor_topic" default="/perception/classifier/tensor" />
  <arg name="triton_output_topic" default="/perception/classifier/output_tensor" />
  <arg name="encoder_output_tensor_name" default="input_tensor" />
  <arg name="triton_input_tensor_names" default="input_tensor" />
  <arg name="triton_output_tensor_names" default="output_logits" />
  <arg name="triton_input_binding_name" default="input_tensor" />
  <arg name="triton_output_binding_name" default="output_logits" />
  <arg name="label_topic" default="/perception/classification/label" />
  <arg name="class_id_topic" default="/perception/classification/class_id" />
  <arg name="confidence_topic" default="/perception/classification/confidence" />
  <arg name="scores_topic" default="/perception/classification/scores" />
  <arg name="target_detected_topic" default="/perception/classification/target_detected" />
  <arg name="container_name" default="camera_container" />
  <arg name="create_container" default="false" />

  <let name="encoder_image_topic"
       value="$(var rgb_image_topic)"
       if="$(var use_rgb_format_converter)" />
  <let name="encoder_image_topic"
       value="$(var input_image_topic)"
       unless="$(var use_rgb_format_converter)" />

  <group if="$(var create_container)">
    <node pkg="rclcpp_components"
          exec="component_container_mt"
          output="screen"
          args="--ros-args -r ComponentManager:__node:=$(var container_name)" />
  </group>

  <group if="$(var use_rgb_format_converter)">
    <load_composable_node target="$(var container_name)">
      <composable_node pkg="isaac_ros_image_proc"
                       plugin="nvidia::isaac_ros::image_proc::ImageFormatConverterNode"
                       name="perception_classifier_image_format_converter">
        <param name="encoding_desired" value="rgb8" />
        <param name="image_width" value="$(var input_image_width)" />
        <param name="image_height" value="$(var input_image_height)" />
        <remap from="image_raw" to="$(var input_image_topic)" />
        <remap from="image" to="$(var rgb_image_topic)" />
      </composable_node>
    </load_composable_node>
  </group>

  <include file="$(find-pkg-share isaac_ros_dnn_image_encoder)/launch/dnn_image_encoder.launch.py">
    <arg name="input_image_width" value="$(var input_image_width)" />
    <arg name="input_image_height" value="$(var input_image_height)" />
    <arg name="network_image_width" value="$(var network_image_width)" />
    <arg name="network_image_height" value="$(var network_image_height)" />
    <arg name="image_input_topic" value="$(var encoder_image_topic)" />
    <arg name="camera_info_input_topic" value="$(var input_camera_info_topic)" />
    <arg name="tensor_output_topic" value="$(var tensor_topic)" />
    <arg name="image_mean" value="[0.5, 0.5, 0.5]" />
    <arg name="image_stddev" value="[0.5, 0.5, 0.5]" />
    <arg name="enable_padding" value="False" />
    <arg name="final_tensor_name" value="$(var encoder_output_tensor_name)" />
    <arg name="attach_to_shared_component_container" value="True" />
    <arg name="component_container_name" value="$(var container_name)" />
    <arg name="dnn_image_encoder_namespace" value="perception_classifier_encoder" />
  </include>

  <load_composable_node target="$(var container_name)">
    <composable_node pkg="isaac_ros_triton"
                     plugin="nvidia::isaac_ros::dnn_inference::TritonNode"
                     name="perception_classifier_triton_node">
      <param name="model_name" value="$(var model_name)" />
      <param name="model_repository_paths" value="['$(var model_repository_path)']" />
      <param name="input_tensor_names" value="['$(var triton_input_tensor_names)']" />
      <param name="output_tensor_names" value="['$(var triton_output_tensor_names)']" />
      <param name="input_binding_names" value="['$(var triton_input_binding_name)']" />
      <param name="output_binding_names" value="['$(var triton_output_binding_name)']" />
      <param name="input_tensor_formats" value="['nitros_tensor_list_nchw_rgb_f32']" />
      <param name="output_tensor_formats" value="['nitros_tensor_list_nhwc_rgb_f32']" />
      <remap from="tensor_sub" to="$(var triton_output_topic)" />
      <remap from="tensor_pub" to="$(var tensor_topic)" />
    </composable_node>
  </load_composable_node>

  <include file="$(find-pkg-share isaac_ros_scan_image_classifier)/launch/scan_image_classifier_decoder.launch.xml">
    <arg name="scan_image_classifier_decoder_param" value="$(var classifier_decoder_param)" />
    <arg name="inference_output_topic" value="$(var triton_output_topic)" />
    <arg name="label_topic" value="$(var label_topic)" />
    <arg name="class_id_topic" value="$(var class_id_topic)" />
    <arg name="confidence_topic" value="$(var confidence_topic)" />
    <arg name="scores_topic" value="$(var scores_topic)" />
    <arg name="target_detected_topic" value="$(var target_detected_topic)" />
    <arg name="container_name" value="$(var container_name)" />
    <arg name="create_container" value="false" />
  </include>
</launch>

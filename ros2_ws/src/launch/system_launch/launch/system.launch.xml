<launch>
    <!-- Boolean toggles -->
    <arg name="record" default="false" description="run rosbag2 record node"/>
    <arg name="use_vehicle" default="true" description="run vehicle driver node"/>
    <arg name="vslam" default="false" description="run vslam node"/>
    <arg name="localization" default="false" description="run localization node"/>
    <arg name="use_lidar" default="false" description="use lidar"/>
    <arg name="use_camera" default="false" description="use camera"/>
    <arg name="use_ftg" default="false" description="run FTG controller in lidar component container"/>
    <arg name="use_emergency" default="false" description="run emergency override controller"/>
    <arg name="use_magp_rl_trajectory" default="false" description="run MAGP RL trajectory policy through Triton and Pure Pursuit"/>
    <arg name="magp_rl_run_pure_pursuit" default="false" />
    <arg name="use_pure_pursuit" default="false" description="run Pure Pursuit controller for neural trajectory"/>
    <arg name="use_sim_time" default="false" />
    <arg name="publish_map" default="false" />
    <arg name="map_server_use_sim_time" default="false" />
    <arg name="use_localization_manager" default="false" />
    <arg name="publish_localization_tf" default="false" />
    <arg name="use_section_localizer" default="false" />
    <arg name="section_localizer_debug_mode" default="false" />
    <arg name="enable_localization_and_mapping" default="false" />

    <!-- Vehicle and command topics -->
    <arg name="vehicle_control_topic" default="/jetracer/cmd_drive" description="final command to vehicle"/>
    <arg name="autonomous_control_cmd" default="/autonomous/cmd_drive" description="autonomous ackermann control command"/>
    <arg name="emergency_scan_topic" default="/scan" />
    <arg name="emergency_control_cmd" default="/emergency/cmd_drive" description="emergency override ackermann command"/>
    <arg name="emergency_signal_topic" default="/emergency/signal" description="emergency override activation signal"/>

    <!-- Sensing -->
    <arg name="lidar_model" default="t_mini_plus" />
    <arg name="lidar_container_name" default="lidar_container" />
    <arg name="camera_model" default="realsense" />
    <arg name="camera_container_name" default="camera_container" />
    <arg name="image_width" default="424" />
    <arg name="image_height" default="240" />
    <arg name="image_fps" default="90.0" />
    <arg name="camera_mount_frame" default="camera_camera_link" />

    <!-- Control -->
    <arg name="ftg_param" default="$(find-pkg-share system_launch)/config/control/ftg_controller.param.yaml" />
    <arg name="ftg_scan_topic" default="/scan" />
    <arg name="emergency_param" default="$(find-pkg-share emergency_controller)/config/emergency_controller.param.yaml" />
    <arg name="magp_rl_model_name" default="magp_rl_trajectory" />
    <arg name="magp_rl_model_repository_path" default="/workspaces/isaac_ros_assets/models/" />
    <arg name="magp_rl_decoder_param" default="$(find-pkg-share isaac_ros_lidar_e2e_control)/config/rl_trajectory_decoder_node.param.yaml" />
    <arg name="magp_rl_scan_topic" default="/scan" />
    <arg name="magp_rl_scan_tensor_topic" default="/encoder/scan_tensor" />
    <arg name="pure_pursuit_param" default="$(find-pkg-share system_launch)/config/control/pure_pursuit_controller.param.yaml" />
    <arg name="pure_pursuit_trajectory_topic" default="/autonomous/trajectory" />
    <arg name="pure_pursuit_velocity_topic" default="/current_velocity" />
    <arg name="pure_pursuit_odometry_topic" default="/visual_slam/tracking/odometry" />

    <!-- Operation tools -->
    <arg name="rosbag_trigger_topic" default="/rosbag2_recorder/trigger" />
    <arg name="rosbag_memo_topic" default="/rosbag2_recorder/memo" />
    <arg name="teleop_param" default="$(find-pkg-share system_launch)/config/tools/teleop.param.yaml" />
    <arg name="bag_manager_param" default="$(find-pkg-share system_launch)/config/tools/bag_manager.param.yaml" />

    <!-- Localization and mapping -->
    <arg name="localization_trigger_topic" default="/localization/trigger" />
    <arg name="localization_trigger_service" default="/trigger_grid_search_localization" />
    <arg name="localization_result_topic" default="/localization_result" />
    <arg name="map_topic" default="/map" />
    <arg name="map_frame" default="map" />
    <arg name="localization_manager_param" default="$(find-pkg-share system_launch)/config/localization/localization_manager.param.yaml" />
    <arg name="localization_feedback_timeout_sec" default="0.0" />
    <arg name="localization_tf_mode" default="map_to_odom" />
    <arg name="localization_tf_map_frame" default="map" />
    <arg name="localization_tf_odom_frame" default="odom" />
    <arg name="localization_tf_base_frame" default="base_link" />
    <arg name="localization_tf_publish_rate_hz" default="20.0" />
    <arg name="section_localizer_param" default="$(find-pkg-share system_launch)/config/localization/section_localizer.param.yaml" />
    <arg name="section_definition_path" default="" />
    <arg name="gate_definition_path" default="" />
    <arg name="section_localizer_map_frame" default="map" />
    <arg name="section_localizer_base_frame" default="base_link" />
    <arg name="section_localizer_topic" default="/localization/current_section" />
    <arg name="section_localizer_update_rate_hz" default="10.0" />
    <arg name="section_localizer_marker_topic" default="/localization/section_markers" />
    <arg name="section_localizer_current_marker_topic" default="/localization/current_section_marker" />
    <arg name="map_yaml_path" default="$(find-pkg-share isaac_ros_occupancy_grid_localizer)/maps/map.yaml" />
    <arg name="map_dir" default="" description="directory containing <map_name>.yaml and optional cuvslam_map/" />
    <arg name="vslam_map_dir" default="" description="explicit cuvslam map directory override" />
    <arg name="vslam_save_map_dir" default="" description="directory to save/update cuvslam map" />

    <let name="resolved_map_dir"
         value="$(eval '\'$(var map_dir)\'.rstrip(\'/\')')" />
    <let name="resolved_map_name"
         value="$(eval '\'$(var resolved_map_dir)\'.split(\'/\')[-1] if \'$(var resolved_map_dir)\' else \'\'')" />
    <let name="resolved_map_yaml_path"
         value="$(var map_yaml_path)"
         unless="$(eval '\'$(var resolved_map_dir)\'.strip() != \'\'')" />
    <let name="resolved_map_yaml_path"
         value="$(eval '\'$(var resolved_map_dir)/$(var resolved_map_name).yaml\'')"
         if="$(eval '\'$(var resolved_map_dir)\'.strip() != \'\'')" />
    <let name="resolved_vslam_map_dir"
         value="$(var vslam_map_dir)"
         if="$(eval '\'$(var vslam_map_dir)\'.strip() != \'\'')" />
    <let name="resolved_vslam_map_dir"
         value=""
         unless="$(eval '\'$(var vslam_map_dir)\'.strip() != \'\' or \'$(var resolved_map_dir)\'.strip() != \'\'')" />
    <let name="resolved_vslam_map_dir"
         value="$(eval '\'$(var resolved_map_dir)/cuvslam_map\'')"
         if="$(eval '\'$(var vslam_map_dir)\'.strip() == \'\' and \'$(var resolved_map_dir)\'.strip() != \'\'')" />
    <let name="resolved_vehicle_camera_frame"
         value="$(var camera_mount_frame)" />
    <let name="resolved_publish_camera_stereo_tf"
         value="true"
         if="$(eval '\'$(var camera_model)\' == \'elp\'')" />
    <let name="resolved_publish_camera_stereo_tf"
         value="false"
         unless="$(eval '\'$(var camera_model)\' == \'elp\'')" />

    <!-- Param files -->
    <arg name="vehicle_param" default="$(find-pkg-share system_launch)/config/vehicle/jetracer_node.param.yaml" />
    <arg name="filter_param" default="$(find-pkg-share system_launch)/config/sensing/scan_filter_footprint_angle.param.yaml" />
    <arg name="localization_param" default="$(find-pkg-share system_launch)/config/localization/map_localization.param.yaml" />

    <!-- Shared composable containers -->
    <node pkg="rclcpp_components" exec="component_container" name="$(var lidar_container_name)" output="screen"/>
    <node pkg="rclcpp_components" exec="component_container_mt" name="$(var camera_container_name)" output="screen"/>

    <!-- Jetracer Driver Node -->
    <group if="$(var use_vehicle)">
        <include file="$(find-pkg-share jetracer_driver)/launch/jetracer.launch.xml">
            <arg name="jetracer_param" value="$(var vehicle_param)"/>
            <arg name="input_control_cmd" value="$(var vehicle_control_topic)"/>
            <arg name="camera_frame" value="$(var resolved_vehicle_camera_frame)"/>
            <arg name="publish_camera_stereo_tf" value="$(var resolved_publish_camera_stereo_tf)"/>
        </include>
    </group>

    <!-- Teleop Manager Node -->
    <include file="$(find-pkg-share teleop_manager)/launch/teleop_manager.launch.xml">
        <arg name="teleop_param" value="$(var teleop_param)"/>
        <arg name="autonomous_control_topic" value="$(var autonomous_control_cmd)"/>
        <arg name="emergency_control_topic" value="$(var emergency_control_cmd)"/>
        <arg name="emergency_signal_topic" value="$(var emergency_signal_topic)"/>
        <arg name="vehicle_control_topic" value="$(var vehicle_control_topic)"/>
        <arg name="trigger_topic" value="$(var rosbag_trigger_topic)"/>  
        <arg name="memo_topic" value="$(var rosbag_memo_topic)"/>
        <arg name="localization_trigger_topic" value="$(var localization_trigger_topic)"/>
    </include>

    <!-- Sensor Kit Nodes -->
    <include file="$(find-pkg-share sensor_kit_launch)/launch/sensor_kit.launch.xml">
        <arg name="use_lidar" value="$(var use_lidar)"/>
        <arg name="lidar_model" value="$(var lidar_model)"/>
        <arg name="lidar_container_name" value="$(var lidar_container_name)"/>
        <arg name="create_lidar_container" value="false"/>
        <arg name="filter_param" value="$(var filter_param)"/>

        <arg name="use_camera" value="$(var use_camera)"/>
        <arg name="camera_model" value="$(var camera_model)"/>
        <arg name="camera_container_name" value="$(var camera_container_name)"/>
        <arg name="create_camera_container" value="false"/>
        <arg name="image_width" value="$(var image_width)"/>
        <arg name="image_height" value="$(var image_height)"/>
        <arg name="image_fps" value="$(var image_fps)"/>
        <arg name="camera_mount_frame" value="$(var resolved_vehicle_camera_frame)"/>
        <arg name="realsense_base_frame" value="$(var resolved_vehicle_camera_frame)"/>
        <arg name="publish_realsense_mount_tf" value="false"/>
    </include>

    <!-- FTG Controller (Composable) -->
    <group if="$(var use_ftg)">
        <include file="$(find-pkg-share ftg_controller)/launch/ftg_controller_component.launch.xml">
            <arg name="ftg_controller_param" value="$(var ftg_param)"/>
            <arg name="scan_topic" value="$(var ftg_scan_topic)"/>
            <arg name="drive_topic" value="$(var autonomous_control_cmd)"/>
            <arg name="container_name" value="$(var lidar_container_name)"/>
            <arg name="create_container" value="false"/>
        </include>
    </group>

    <!-- MAGP RL trajectory policy: scan -> Triton -> trajectory -> Pure Pursuit -->
    <group if="$(var use_magp_rl_trajectory)">
        <include file="$(find-pkg-share isaac_ros_lidar_e2e_control)/launch/magp_rl_lidar_trajectory.launch.xml">
            <arg name="lidar_encoder_node_param" value="$(find-pkg-share isaac_ros_lidar_e2e_control)/config/lidar_encoder_node.param.yaml" />
            <arg name="rl_trajectory_decoder_node_param" value="$(var magp_rl_decoder_param)" />
            <arg name="pure_pursuit_controller_param" value="$(var pure_pursuit_param)" />
            <arg name="container_name" value="$(var lidar_container_name)" />
            <arg name="model_repository_path" value="$(var magp_rl_model_repository_path)" />
            <arg name="model_name" value="$(var magp_rl_model_name)" />
            <arg name="scan_topic" value="$(var magp_rl_scan_topic)" />
            <arg name="scan_tensor_topic" value="$(var magp_rl_scan_tensor_topic)" />
            <arg name="output_trajectory_topic" value="$(var pure_pursuit_trajectory_topic)" />
            <arg name="output_control_topic" value="$(var autonomous_control_cmd)" />
            <arg name="velocity_topic" value="$(var pure_pursuit_velocity_topic)" />
            <arg name="odometry_topic" value="$(var pure_pursuit_odometry_topic)" />
            <arg name="run_pure_pursuit" value="$(var magp_rl_run_pure_pursuit)" />
        </include>
    </group>

    <!-- Pure Pursuit Controller for Neural Trajectory -->
    <group if="$(var use_pure_pursuit)">
        <include file="$(find-pkg-share pure_pursuit_controller)/launch/pure_pursuit_controller.launch.xml">
            <arg name="pure_pursuit_controller_param" value="$(var pure_pursuit_param)"/>
            <arg name="trajectory_topic" value="$(var pure_pursuit_trajectory_topic)"/>
            <arg name="drive_topic" value="$(var autonomous_control_cmd)"/>
            <arg name="velocity_topic" value="$(var pure_pursuit_velocity_topic)"/>
            <arg name="odometry_topic" value="$(var pure_pursuit_odometry_topic)"/>
        </include>
    </group>

    <!-- Emergency Controller -->
    <group if="$(var use_emergency)">
        <include file="$(find-pkg-share emergency_controller)/launch/emergency_controller.launch.xml">
            <arg name="emergency_controller_param" value="$(var emergency_param)"/>
            <arg name="scan_topic" value="$(var emergency_scan_topic)"/>
            <arg name="input_drive_topic" value="$(var autonomous_control_cmd)"/>
            <arg name="output_drive_topic" value="$(var emergency_control_cmd)"/>
            <arg name="signal_topic" value="$(var emergency_signal_topic)"/>
        </include>
    </group>

    <!-- Rosbag2 Recorder Node -->
    <group if="$(var record)">
        <include file="$(find-pkg-share bag_manager_py)/launch/bag_manager.launch.xml">
            <arg name="bag_manager_param" value="$(var bag_manager_param)"/>
            <arg name="trigger_topic" value="$(var rosbag_trigger_topic)"/>
            <arg name="memo_topic" value="$(var rosbag_memo_topic)"/>
        </include>
    </group>

    <!-- VSLAM Nodes -->
    <group if="$(var vslam)">
        <include file="$(find-pkg-share system_launch)/launch/vslam.launch.xml">
            <arg name="image_width" value="$(var image_width)"/>
            <arg name="image_height" value="$(var image_height)"/>
            <arg name="camera_container_name" value="$(var camera_container_name)"/>
            <arg name="enable_localization_and_mapping" value="$(var enable_localization_and_mapping)"/>
            <arg name="load_map_path" value="$(var resolved_vslam_map_dir)"/>
            <arg name="save_map_path" value="$(var vslam_save_map_dir)"/>
        </include>
    </group>

    <!-- Localization Nodes -->
    <group if="$(var localization)">
        <include file="$(find-pkg-share system_launch)/launch/localization.launch.xml">
            <arg name="lidar_container_name" value="$(var lidar_container_name)"/>
            <arg name="localization_trigger_topic" value="$(var localization_trigger_topic)"/>
            <arg name="localization_trigger_service" value="$(var localization_trigger_service)"/>
            <arg name="use_sim_time" value="$(var use_sim_time)"/>
            <arg name="localization_result_topic" value="$(var localization_result_topic)"/>
            <arg name="publish_map" value="$(var publish_map)"/>
            <arg name="map_topic" value="$(var map_topic)"/>
            <arg name="map_frame" value="$(var map_frame)"/>
            <arg name="map_server_use_sim_time" value="$(var map_server_use_sim_time)"/>
            <arg name="use_localization_manager" value="$(var use_localization_manager)"/>
            <arg name="localization_manager_param" value="$(var localization_manager_param)"/>
            <arg name="localization_feedback_timeout_sec" value="$(var localization_feedback_timeout_sec)"/>
            <arg name="publish_localization_tf" value="$(var publish_localization_tf)"/>
            <arg name="localization_tf_mode" value="$(var localization_tf_mode)"/>
            <arg name="localization_tf_map_frame" value="$(var localization_tf_map_frame)"/>
            <arg name="localization_tf_odom_frame" value="$(var localization_tf_odom_frame)"/>
            <arg name="localization_tf_base_frame" value="$(var localization_tf_base_frame)"/>
            <arg name="localization_tf_publish_rate_hz" value="$(var localization_tf_publish_rate_hz)"/>
            <arg name="use_section_localizer" value="$(var use_section_localizer)"/>
            <arg name="section_localizer_param" value="$(var section_localizer_param)"/>
            <arg name="section_definition_path" value="$(var section_definition_path)"/>
            <arg name="gate_definition_path" value="$(var gate_definition_path)"/>
            <arg name="section_localizer_map_frame" value="$(var section_localizer_map_frame)"/>
            <arg name="section_localizer_base_frame" value="$(var section_localizer_base_frame)"/>
            <arg name="section_localizer_topic" value="$(var section_localizer_topic)"/>
            <arg name="section_localizer_update_rate_hz" value="$(var section_localizer_update_rate_hz)"/>
            <arg name="section_localizer_debug_mode" value="$(var section_localizer_debug_mode)"/>
            <arg name="section_localizer_marker_topic" value="$(var section_localizer_marker_topic)"/>
            <arg name="section_localizer_current_marker_topic" value="$(var section_localizer_current_marker_topic)"/>
            <arg name="map_yaml_path" value="$(var resolved_map_yaml_path)"/>
            <arg name="localization_param" value="$(var localization_param)"/>
        </include>
    </group>

</launch>

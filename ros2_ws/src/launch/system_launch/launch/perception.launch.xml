<launch>
  <arg name="perception_param"
       default="$(find-pkg-share system_launch)/config/perception/scan_image_projection_cropper.param.yaml" />
  <arg name="scan_topic" default="/scan" />

  <arg name="camera_source" default="left" />
  <arg name="input_image_topic" default="" />
  <arg name="input_camera_info_topic" default="" />
  <arg name="use_rectify" default="true" />
  <arg name="color_image_width" default="640" />
  <arg name="color_image_height" default="480" />
  <arg name="stereo_image_width" default="424" />
  <arg name="stereo_image_height" default="240" />
  <arg name="rectified_image_width" default="" />
  <arg name="rectified_image_height" default="" />
  <arg name="rectified_image_topic" default="/perception/image_rect" />
  <arg name="rectified_camera_info_topic" default="/perception/camera_info_rect" />

  <arg name="debug_input_image_topic" default="" />
  <arg name="debug_input_camera_info_topic" default="" />
  <arg name="crop_image_topic" default="/perception/crop/image" />
  <arg name="crop_camera_info_topic" default="/perception/crop/camera_info" />
  <arg name="crop_roi_topic" default="/perception/crop/roi" />
  <arg name="debug_image_topic" default="/perception/debug/image" />

  <arg name="use_classifier" default="false" />
  <arg name="classifier_decoder_param"
       default="$(find-pkg-share system_launch)/config/perception/scan_image_classifier_decoder.param.yaml" />
  <arg name="classifier_input_image_topic" default="" />
  <arg name="classifier_input_camera_info_topic" default="" />
  <arg name="classifier_input_image_width" default="64" />
  <arg name="classifier_input_image_height" default="64" />
  <arg name="classifier_network_image_width" default="64" />
  <arg name="classifier_network_image_height" default="64" />
  <arg name="classifier_model_repository_path" default="/workspaces/isaac_ros_assets/models/" />
  <arg name="classifier_model_name" default="scan_image_classifier" />
  <arg name="classifier_use_rgb_format_converter" default="true" />
  <arg name="classifier_rgb_image_topic" default="/perception/classifier/image_rgb" />
  <arg name="classifier_tensor_topic" default="/perception/classifier/tensor" />
  <arg name="classifier_triton_output_topic" default="/perception/classifier/output_tensor" />
  <arg name="classifier_encoder_output_tensor_name" default="input_tensor" />
  <arg name="classifier_triton_input_tensor_names" default="input_tensor" />
  <arg name="classifier_triton_output_tensor_names" default="output_logits" />
  <arg name="classifier_triton_input_binding_name" default="input_tensor" />
  <arg name="classifier_triton_output_binding_name" default="output_logits" />
  <arg name="classifier_label_topic" default="/perception/classification/label" />
  <arg name="classifier_class_id_topic" default="/perception/classification/class_id" />
  <arg name="classifier_confidence_topic" default="/perception/classification/confidence" />
  <arg name="classifier_scores_topic" default="/perception/classification/scores" />
  <arg name="classifier_target_detected_topic" default="/perception/classification/target_detected" />
  <arg name="crop_obstacle_position_topic" default="/perception/crop/obstacle_position" />
  
  <arg name="perception_object_tracker_param" default="" />
  <arg name="tracked_object_topic" default="/perception/tracked_object" />
  
  <arg name="path_obstacle_filter_param" default="" />

  <arg name="container_name" default="camera_container" />
  <arg name="create_container" default="false" />

  <let name="resolved_input_image_topic"
       value="$(var input_image_topic)"
       if="$(eval '\'$(var input_image_topic)\'.strip() != \'\'' )" />
  <let name="resolved_input_image_topic"
       value="/realsense2_camera/color/image_raw"
       if="$(eval '\'$(var input_image_topic)\'.strip() == \'\' and \'$(var camera_source)\' == \'color\'')" />
  <let name="resolved_input_image_topic"
       value="/camera/left/image_raw"
       if="$(eval '\'$(var input_image_topic)\'.strip() == \'\' and \'$(var camera_source)\' == \'left\'')" />
  <let name="resolved_input_image_topic"
       value="/camera/right/image_raw"
       if="$(eval '\'$(var input_image_topic)\'.strip() == \'\' and \'$(var camera_source)\' == \'right\'')" />

  <let name="resolved_input_camera_info_topic"
       value="$(var input_camera_info_topic)"
       if="$(eval '\'$(var input_camera_info_topic)\'.strip() != \'\'' )" />
  <let name="resolved_input_camera_info_topic"
       value="/realsense2_camera/color/camera_info"
       if="$(eval '\'$(var input_camera_info_topic)\'.strip() == \'\' and \'$(var camera_source)\' == \'color\'')" />
  <let name="resolved_input_camera_info_topic"
       value="/camera/left/camera_info"
       if="$(eval '\'$(var input_camera_info_topic)\'.strip() == \'\' and \'$(var camera_source)\' == \'left\'')" />
  <let name="resolved_input_camera_info_topic"
       value="/camera/right/camera_info"
       if="$(eval '\'$(var input_camera_info_topic)\'.strip() == \'\' and \'$(var camera_source)\' == \'right\'')" />

  <let name="resolved_debug_input_image_topic"
       value="$(var debug_input_image_topic)"
       if="$(eval '\'$(var debug_input_image_topic)\'.strip() != \'\'' )" />
  <let name="resolved_debug_input_image_topic"
       value="$(var resolved_input_image_topic)"
       unless="$(eval '\'$(var debug_input_image_topic)\'.strip() != \'\'' )" />

  <let name="resolved_debug_input_camera_info_topic"
       value="$(var debug_input_camera_info_topic)"
       if="$(eval '\'$(var debug_input_camera_info_topic)\'.strip() != \'\'' )" />
  <let name="resolved_debug_input_camera_info_topic"
       value="$(var resolved_input_camera_info_topic)"
       unless="$(eval '\'$(var debug_input_camera_info_topic)\'.strip() != \'\'' )" />

  <let name="resolved_rectified_image_width"
       value="$(var rectified_image_width)"
       if="$(eval '\'$(var rectified_image_width)\'.strip() != \'\'' )" />
  <let name="resolved_rectified_image_width"
       value="$(var color_image_width)"
       if="$(eval '\'$(var rectified_image_width)\'.strip() == \'\' and \'$(var camera_source)\' == \'color\'')" />
  <let name="resolved_rectified_image_width"
       value="$(var stereo_image_width)"
       if="$(eval '\'$(var rectified_image_width)\'.strip() == \'\' and \'$(var camera_source)\' in [\'left\', \'right\']')" />

  <let name="resolved_rectified_image_height"
       value="$(var rectified_image_height)"
       if="$(eval '\'$(var rectified_image_height)\'.strip() != \'\'' )" />
  <let name="resolved_rectified_image_height"
       value="$(var color_image_height)"
       if="$(eval '\'$(var rectified_image_height)\'.strip() == \'\' and \'$(var camera_source)\' == \'color\'')" />
  <let name="resolved_rectified_image_height"
       value="$(var stereo_image_height)"
       if="$(eval '\'$(var rectified_image_height)\'.strip() == \'\' and \'$(var camera_source)\' in [\'left\', \'right\']')" />

  <let name="resolved_classifier_input_image_topic"
       value="$(var classifier_input_image_topic)"
       if="$(eval '\'$(var classifier_input_image_topic)\'.strip() != \'\'' )" />
  <let name="resolved_classifier_input_image_topic"
       value="$(var crop_image_topic)"
       unless="$(eval '\'$(var classifier_input_image_topic)\'.strip() != \'\'' )" />

  <let name="resolved_classifier_input_camera_info_topic"
       value="$(var classifier_input_camera_info_topic)"
       if="$(eval '\'$(var classifier_input_camera_info_topic)\'.strip() != \'\'' )" />
  <let name="resolved_classifier_input_camera_info_topic"
       value="$(var crop_camera_info_topic)"
       unless="$(eval '\'$(var classifier_input_camera_info_topic)\'.strip() != \'\'' )" />

  <let name="resolved_classifier_input_image_width"
       value="$(var classifier_input_image_width)"
       if="$(eval '\'$(var classifier_input_image_width)\'.strip() != \'\'' )" />
  <let name="resolved_classifier_input_image_width"
       value="$(var resolved_rectified_image_width)"
       unless="$(eval '\'$(var classifier_input_image_width)\'.strip() != \'\'' )" />

  <let name="resolved_classifier_input_image_height"
       value="$(var classifier_input_image_height)"
       if="$(eval '\'$(var classifier_input_image_height)\'.strip() != \'\'' )" />
  <let name="resolved_classifier_input_image_height"
       value="$(var resolved_rectified_image_height)"
       unless="$(eval '\'$(var classifier_input_image_height)\'.strip() != \'\'' )" />

  <let name="perception_image_topic"
       value="$(var rectified_image_topic)"
       if="$(var use_rectify)" />
  <let name="perception_image_topic"
       value="$(var resolved_input_image_topic)"
       unless="$(var use_rectify)" />
  <let name="perception_camera_info_topic"
       value="$(var rectified_camera_info_topic)"
       if="$(var use_rectify)" />
  <let name="perception_camera_info_topic"
       value="$(var resolved_input_camera_info_topic)"
       unless="$(var use_rectify)" />

  <group if="$(var create_container)">
    <node pkg="rclcpp_components"
          exec="component_container_mt"
          name="$(var container_name)"
          output="screen"/>
  </group>

  <group if="$(var use_rectify)">
    <load_composable_node target="$(var container_name)">
      <composable_node pkg="isaac_ros_image_proc"
                       plugin="nvidia::isaac_ros::image_proc::RectifyNode"
                       name="perception_rectify_node">
        <param name="output_width" value="$(var resolved_rectified_image_width)" />
        <param name="output_height" value="$(var resolved_rectified_image_height)" />
        <remap from="image_raw" to="$(var resolved_input_image_topic)" />
        <remap from="camera_info" to="$(var resolved_input_camera_info_topic)" />
        <remap from="image_rect" to="$(var rectified_image_topic)" />
        <remap from="camera_info_rect" to="$(var rectified_camera_info_topic)" />
      </composable_node>
    </load_composable_node>
  </group>

  <include file="$(find-pkg-share scan_image_projection_cropper)/launch/scan_image_projection_cropper.launch.xml">
    <arg name="scan_image_projection_cropper_param" value="$(var perception_param)" />
    <arg name="scan_topic" value="$(var scan_topic)" />
    <arg name="image_topic" value="$(var perception_image_topic)" />
    <arg name="camera_info_topic" value="$(var perception_camera_info_topic)" />
    <arg name="crop_image_topic" value="$(var crop_image_topic)" />
    <arg name="crop_camera_info_topic" value="$(var crop_camera_info_topic)" />
    <arg name="crop_roi_topic" value="$(var crop_roi_topic)" />
    <arg name="debug_input_image_topic" value="$(var resolved_debug_input_image_topic)" />
    <arg name="debug_input_camera_info_topic" value="$(var resolved_debug_input_camera_info_topic)" />
    <arg name="debug_image_topic" value="$(var debug_image_topic)" />
    <arg name="tracked_object_topic" value="$(var tracked_object_topic)" />
    <arg name="container_name" value="$(var container_name)" />
    <arg name="create_container" value="false" />
  </include>

  <group if="$(var use_classifier)">
    <include file="$(find-pkg-share system_launch)/launch/perception_classifier.launch.xml">
      <arg name="classifier_decoder_param" value="$(var classifier_decoder_param)" />
      <arg name="input_image_topic" value="$(var resolved_classifier_input_image_topic)" />
      <arg name="input_camera_info_topic" value="$(var resolved_classifier_input_camera_info_topic)" />
      <arg name="input_image_width" value="$(var resolved_classifier_input_image_width)" />
      <arg name="input_image_height" value="$(var resolved_classifier_input_image_height)" />
      <arg name="network_image_width" value="$(var classifier_network_image_width)" />
      <arg name="network_image_height" value="$(var classifier_network_image_height)" />
      <arg name="model_repository_path" value="$(var classifier_model_repository_path)" />
      <arg name="model_name" value="$(var classifier_model_name)" />
      <arg name="use_rgb_format_converter" value="$(var classifier_use_rgb_format_converter)" />
      <arg name="rgb_image_topic" value="$(var classifier_rgb_image_topic)" />
      <arg name="tensor_topic" value="$(var classifier_tensor_topic)" />
      <arg name="triton_output_topic" value="$(var classifier_triton_output_topic)" />
      <arg name="encoder_output_tensor_name" value="$(var classifier_encoder_output_tensor_name)" />
      <arg name="triton_input_tensor_names" value="$(var classifier_triton_input_tensor_names)" />
      <arg name="triton_output_tensor_names" value="$(var classifier_triton_output_tensor_names)" />
      <arg name="triton_input_binding_name" value="$(var classifier_triton_input_binding_name)" />
      <arg name="triton_output_binding_name" value="$(var classifier_triton_output_binding_name)" />
      <arg name="label_topic" value="$(var classifier_label_topic)" />
      <arg name="class_id_topic" value="$(var classifier_class_id_topic)" />
      <arg name="confidence_topic" value="$(var classifier_confidence_topic)" />
      <arg name="scores_topic" value="$(var classifier_scores_topic)" />
      <arg name="target_detected_topic" value="$(var classifier_target_detected_topic)" />
      <arg name="container_name" value="$(var container_name)" />
      <arg name="create_container" value="false" />
    </include>

    <!-- Object Tracker (requires classifier output & obstacle position) -->
    <include file="$(find-pkg-share perception_object_tracker)/launch/perception_object_tracker.launch.xml">
      <arg name="param_file" value="$(var perception_object_tracker_param)" />
      <arg name="target_detected_topic" value="$(var classifier_target_detected_topic)" />
      <arg name="obstacle_position_topic" value="$(var crop_obstacle_position_topic)" />
      <arg name="tracked_object_topic" value="$(var tracked_object_topic)" />
    </include>

    <!-- Path obstacle filter (requires tracker output) -->
    <include file="$(find-pkg-share path_obstacle_filter)/launch/path_obstacle_filter.launch.xml">
      <arg name="param_file" value="$(var path_obstacle_filter_param)" />
      <arg name="tracked_object_topic" value="$(var tracked_object_topic)" />
    </include>
  </group>
</launch>

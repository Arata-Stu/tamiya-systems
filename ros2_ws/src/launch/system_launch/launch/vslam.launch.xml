<launch>
    <!-- 解像度は system.launch.xml から伝播されます。直接呼び出す場合は system.launch.xmlと整合すること。 -->
    <arg name="image_width" default="424" />
    <arg name="image_height" default="240" />
    <arg name="camera_container_name" default="camera_container" />
    <arg name="vslam_container_name" default="$(var camera_container_name)" />
    <arg name="create_vslam_container" default="false" />
    <arg name="use_image_preprocessors" default="true" />
    <arg name="use_sim_time" default="false" />
    <arg name="vslam_map_frame" default="map" />
    <arg name="vslam_map_parent_frame" default="map" />
    <arg name="publish_vslam_map_identity_tf" default="true" />
    <arg name="use_vslam_map_alignment_node" default="false" />
    <arg name="vslam_map_alignment_config" default="" />
    <arg name="vslam_map_alignment_enable_keyboard" default="false" />
    <arg name="vslam_map_alignment_publish_rate_hz" default="20.0" />
    <arg name="vslam_map_alignment_translation_step_m" default="0.02" />
    <arg name="vslam_map_alignment_rotation_step_deg" default="1.0" />
    <arg name="vslam_map_alignment_x" default="0.0" />
    <arg name="vslam_map_alignment_y" default="0.0" />
    <arg name="vslam_map_alignment_z" default="0.0" />
    <arg name="vslam_map_alignment_roll_rad" default="0.0" />
    <arg name="vslam_map_alignment_pitch_rad" default="0.0" />
    <arg name="vslam_map_alignment_yaw_rad" default="0.0" />

    <arg name="vslam_param" default="$(find-pkg-share system_launch)/config/localization/vslam.param.yaml" />
    <arg name="save_map_path" default="" />
    <arg name="load_map_path" default="" />
    <arg name="enable_localization_and_mapping" default="true" />
    <arg name="localize_on_startup" default="false" />
    <arg name="publish_map_to_odom_tf" default="false" />
    <arg name="enable_slam_visualization" default="false" />
    <arg name="enable_observations_view" default="false" />
    <arg name="enable_landmarks_view" default="false" />

    <group if="$(var create_vslam_container)">
        <node pkg="rclcpp_components"
              exec="component_container_mt"
              output="screen"
              args="--ros-args -r ComponentManager:__node:=$(var vslam_container_name)"/>
    </group>

    <let name="visual_slam_left_image_topic" value="/camera/left/image_rect_mono"
         if="$(var use_image_preprocessors)"/>
    <let name="visual_slam_left_camera_info_topic" value="/camera/left/camera_info_rect"
         if="$(var use_image_preprocessors)"/>
    <let name="visual_slam_right_image_topic" value="/camera/right/image_rect_mono"
         if="$(var use_image_preprocessors)"/>
    <let name="visual_slam_right_camera_info_topic" value="/camera/right/camera_info_rect"
         if="$(var use_image_preprocessors)"/>
    <let name="visual_slam_left_image_topic" value="/camera/left/image_raw"
         unless="$(var use_image_preprocessors)"/>
    <let name="visual_slam_left_camera_info_topic" value="/camera/left/camera_info"
         unless="$(var use_image_preprocessors)"/>
    <let name="visual_slam_right_image_topic" value="/camera/right/image_raw"
         unless="$(var use_image_preprocessors)"/>
    <let name="visual_slam_right_camera_info_topic" value="/camera/right/camera_info"
         unless="$(var use_image_preprocessors)"/>

    <group if="$(var use_image_preprocessors)">
        <load_composable_node target="$(var vslam_container_name)">
            <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::RectifyNode" name="rectify_node_left">
                <param name="use_sim_time" value="$(var use_sim_time)"/>
                <param name="output_width" value="$(var image_width)"/>
                <param name="output_height" value="$(var image_height)"/>
                <remap from="image_raw" to="/camera/left/image_raw"/>
                <remap from="camera_info" to="/camera/left/camera_info"/>
                <remap from="image_rect" to="/camera/left/image_rect"/>
                <remap from="camera_info_rect" to="/camera/left/camera_info_rect"/>
            </composable_node>
        </load_composable_node>

        <load_composable_node target="$(var vslam_container_name)">
            <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::RectifyNode" name="rectify_node_right">
                <param name="use_sim_time" value="$(var use_sim_time)"/>
                <param name="output_width" value="$(var image_width)"/>
                <param name="output_height" value="$(var image_height)"/>
                <remap from="image_raw" to="/camera/right/image_raw"/>
                <remap from="camera_info" to="/camera/right/camera_info"/>
                <remap from="image_rect" to="/camera/right/image_rect"/>
                <remap from="camera_info_rect" to="/camera/right/camera_info_rect"/>
            </composable_node>
        </load_composable_node>

        <load_composable_node target="$(var vslam_container_name)">
            <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::ImageFormatConverterNode" name="image_format_node_left">
                <param name="use_sim_time" value="$(var use_sim_time)"/>
                <param name="encoding_desired" value="mono8"/>
                <param name="image_width" value="$(var image_width)"/>
                <param name="image_height" value="$(var image_height)"/>
                <remap from="image_raw" to="/camera/left/image_rect"/>
                <remap from="image" to="/camera/left/image_rect_mono"/>
            </composable_node>
        </load_composable_node>

        <load_composable_node target="$(var vslam_container_name)">
            <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::ImageFormatConverterNode" name="image_format_node_right">
                <param name="use_sim_time" value="$(var use_sim_time)"/>
                <param name="encoding_desired" value="mono8"/>
                <param name="image_width" value="$(var image_width)"/>
                <param name="image_height" value="$(var image_height)"/>
                <remap from="image_raw" to="/camera/right/image_rect"/>
                <remap from="image" to="/camera/right/image_rect_mono"/>
            </composable_node>
        </load_composable_node>
    </group>

    <load_composable_node target="$(var vslam_container_name)">
        <composable_node pkg="isaac_ros_visual_slam" plugin="nvidia::isaac_ros::visual_slam::VisualSlamNode" name="visual_slam_node">
            <param from ="$(var vslam_param)"/>
            <param name="use_sim_time" value="$(var use_sim_time)"/>
            <param name="map_frame" value="$(var vslam_map_frame)"/>
            <param name="save_map_folder_path" value="$(var save_map_path)"/>
            <param name="load_map_folder_path" value="$(var load_map_path)"/>
            <param name="enable_localization_n_mapping" value="$(var enable_localization_and_mapping)"/>
            <param name="localize_on_startup" value="$(var localize_on_startup)"/>
            <param name="publish_map_to_odom_tf" value="$(var publish_map_to_odom_tf)"/>
            <param name="enable_slam_visualization" value="$(var enable_slam_visualization)"/>
            <param name="enable_observations_view" value="$(var enable_observations_view)"/>
            <param name="enable_landmarks_view" value="$(var enable_landmarks_view)"/>

            <remap from="/visual_slam/image_0" to="$(var visual_slam_left_image_topic)"/>
            <remap from="/visual_slam/camera_info_0" to="$(var visual_slam_left_camera_info_topic)"/>
            <remap from="/visual_slam/image_1" to="$(var visual_slam_right_image_topic)"/>
            <remap from="/visual_slam/camera_info_1" to="$(var visual_slam_right_camera_info_topic)"/>

            <remap from="/visual_slam/imu" to="/camera/imu" />
        </composable_node>
    </load_composable_node>

    <node
        if="$(eval '\'$(var use_vslam_map_alignment_node)\' == \'true\' and \'$(var vslam_map_parent_frame)\' != \'$(var vslam_map_frame)\'')"
        pkg="vslam_map_tools"
        exec="manual_tf_alignment_node.py"
        name="manual_tf_alignment_node"
        output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="parent_frame" value="$(var vslam_map_parent_frame)"/>
        <param name="child_frame" value="$(var vslam_map_frame)"/>
        <param name="config_path" value="$(var vslam_map_alignment_config)"/>
        <param name="enable_keyboard" value="$(var vslam_map_alignment_enable_keyboard)"/>
        <param name="publish_rate_hz" value="$(var vslam_map_alignment_publish_rate_hz)"/>
        <param name="translation_step_m" value="$(var vslam_map_alignment_translation_step_m)"/>
        <param name="rotation_step_deg" value="$(var vslam_map_alignment_rotation_step_deg)"/>
        <param name="x" value="$(var vslam_map_alignment_x)"/>
        <param name="y" value="$(var vslam_map_alignment_y)"/>
        <param name="z" value="$(var vslam_map_alignment_z)"/>
        <param name="roll_rad" value="$(var vslam_map_alignment_roll_rad)"/>
        <param name="pitch_rad" value="$(var vslam_map_alignment_pitch_rad)"/>
        <param name="yaw_rad" value="$(var vslam_map_alignment_yaw_rad)"/>
    </node>

    <node
        if="$(eval '\'$(var publish_vslam_map_identity_tf)\' == \'true\' and \'$(var use_vslam_map_alignment_node)\' != \'true\' and \'$(var vslam_map_parent_frame)\' != \'$(var vslam_map_frame)\'')"
        pkg="tf2_ros"
        exec="static_transform_publisher"
        name="vslam_map_identity_tf"
        args="0 0 0 0 0 0 $(var vslam_map_parent_frame) $(var vslam_map_frame)" />

</launch>

<launch>
  <arg name="lidar_container_name" default="lidar_container" />
  <arg name="map_yaml_path" default="$(find-pkg-share isaac_ros_occupancy_grid_localizer)/maps/map.yaml" />
  <arg name="localization_param" default="$(find-pkg-share system_launch)/config/localization/map_localization.param.yaml" />
  <arg name="scan_topic" default="/scan" />
  <arg name="flatscan_topic" default="/flatscan" />
  <arg name="localization_result_topic" default="/localization_result" />
  <arg name="localization_trigger_topic" default="/localization/trigger" />
  <arg name="localization_trigger_service" default="/trigger_grid_search_localization" />
  <arg name="use_amcl" default="false" />
  <arg name="amcl_param" default="$(find-pkg-share system_launch)/config/localization/amcl.param.yaml" />
  <arg name="amcl_pose_topic" default="/amcl_pose" />
  <arg name="amcl_initial_pose_topic" default="/initialpose" />
  <arg name="amcl_pose_max_xy_variance" default="-1.0" />
  <arg name="amcl_pose_max_yaw_variance" default="-1.0" />
  <arg name="publish_initialpose_to_amcl" default="$(var use_amcl)" />
  <arg name="use_sim_time" default="false" />
  <arg name="publish_map" default="true" />
  <arg name="map_topic" default="/map" />
  <arg name="map_frame" default="map" />
  <arg name="map_server_use_sim_time" default="false" />
  <arg name="use_localization_manager" default="true" />
  <arg name="localization_manager_param" default="$(find-pkg-share localization_manager)/config/localization_manager.param.yaml" />
  <arg name="localization_feedback_timeout_sec" default="0.0" />
  <arg name="publish_localization_tf" default="true" />
  <arg name="localization_tf_mode" default="map_to_odom" />
  <arg name="localization_tf_map_frame" default="map" />
  <arg name="localization_tf_odom_frame" default="odom" />
  <arg name="localization_tf_base_frame" default="base_link" />
  <arg name="localization_tf_publish_rate_hz" default="20.0" />
  <arg name="use_section_localizer" default="false" />
  <arg name="section_localizer_param" default="$(find-pkg-share system_launch)/config/localization/section_localizer.param.yaml" />
  <arg name="section_definition_path" default="" />
  <arg name="gate_definition_path" default="" />
  <arg name="section_localizer_map_frame" default="map" />
  <arg name="section_localizer_base_frame" default="base_link" />
  <arg name="section_localizer_topic" default="/localization/current_section" />
  <arg name="section_localizer_update_rate_hz" default="10.0" />
  <arg name="section_localizer_debug_mode" default="true" />
  <arg name="section_localizer_marker_topic" default="/localization/section_markers" />
  <arg name="section_localizer_current_marker_topic" default="/localization/current_section_marker" />

  <group if="$(var publish_map)">
    <node pkg="nav2_map_server"
          exec="map_server"
          name="map_server"
          output="screen">
      <param name="yaml_filename" value="$(var map_yaml_path)" />
      <param name="topic_name" value="$(var map_topic)" />
      <param name="frame_id" value="$(var map_frame)" />
      <param name="use_sim_time" value="$(var map_server_use_sim_time)" />
    </node>

    <node pkg="nav2_lifecycle_manager"
          exec="lifecycle_manager"
          name="lifecycle_manager_map_server"
          output="screen">
      <param name="use_sim_time" value="$(var map_server_use_sim_time)" />
      <param name="autostart" value="true" />
      <param name="node_names" value="['map_server']" />
    </node>
  </group>

  <load_composable_node target="$(var lidar_container_name)">
    <composable_node pkg="isaac_ros_pointcloud_utils"
                     plugin="nvidia::isaac_ros::pointcloud_utils::LaserScantoFlatScanNode"
                     name="laserscan_to_flatscan">
      <remap from="scan" to="$(var scan_topic)" />
      <remap from="flatscan" to="$(var flatscan_topic)" />
    </composable_node>
  </load_composable_node>

  <load_composable_node target="$(var lidar_container_name)">
    <composable_node pkg="isaac_ros_occupancy_grid_localizer"
                     plugin="nvidia::isaac_ros::occupancy_grid_localizer::OccupancyGridLocalizerNode"
                     name="occupancy_grid_localizer">
      <param from="$(var map_yaml_path)" />
      <param from="$(var localization_param)" />
      <param name="loc_result_frame" value="map" />
      <param name="map_yaml_path" value="$(var map_yaml_path)" />
      <remap from="flatscan" to="$(var flatscan_topic)" />
      <remap from="localization_result" to="$(var localization_result_topic)" />
      <remap from="trigger_grid_search_localization" to="$(var localization_trigger_service)" />
    </composable_node>
  </load_composable_node>

  <group if="$(var use_amcl)">
    <node pkg="nav2_amcl"
          exec="amcl"
          name="amcl"
          output="screen">
      <param from="$(var amcl_param)" />
      <param name="use_sim_time" value="$(var use_sim_time)" />
      <param name="global_frame_id" value="$(var map_frame)" />
      <param name="odom_frame_id" value="$(var localization_tf_odom_frame)" />
      <param name="base_frame_id" value="$(var localization_tf_base_frame)" />
      <param name="scan_topic" value="$(var scan_topic)" />
      <param name="tf_broadcast" value="false" />
      <remap from="scan" to="$(var scan_topic)" />
      <remap from="map" to="$(var map_topic)" />
      <remap from="amcl_pose" to="$(var amcl_pose_topic)" />
      <remap from="initialpose" to="$(var amcl_initial_pose_topic)" />
    </node>

    <node pkg="nav2_lifecycle_manager"
          exec="lifecycle_manager"
          name="lifecycle_manager_amcl"
          output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)" />
      <param name="autostart" value="true" />
      <param name="node_names" value="['amcl']" />
    </node>
  </group>

  <group if="$(var use_localization_manager)">
    <include file="$(find-pkg-share localization_manager)/launch/localization_manager.launch.xml">
      <arg name="localization_manager_param" value="$(var localization_manager_param)" />
      <arg name="localization_trigger_topic" value="$(var localization_trigger_topic)" />
      <arg name="localization_trigger_service" value="$(var localization_trigger_service)" />
      <arg name="localization_result_topic" value="$(var localization_result_topic)" />
      <arg name="localization_feedback_timeout_sec" value="$(var localization_feedback_timeout_sec)" />
      <arg name="use_amcl_pose" value="$(var use_amcl)" />
      <arg name="amcl_pose_topic" value="$(var amcl_pose_topic)" />
      <arg name="amcl_pose_max_xy_variance" value="$(var amcl_pose_max_xy_variance)" />
      <arg name="amcl_pose_max_yaw_variance" value="$(var amcl_pose_max_yaw_variance)" />
      <arg name="publish_initialpose_to_amcl" value="$(var publish_initialpose_to_amcl)" />
      <arg name="initial_pose_topic" value="$(var amcl_initial_pose_topic)" />
      <arg name="use_sim_time" value="$(var use_sim_time)" />
      <arg name="publish_localization_tf" value="$(var publish_localization_tf)" />
      <arg name="localization_tf_mode" value="$(var localization_tf_mode)" />
      <arg name="localization_tf_map_frame" value="$(var localization_tf_map_frame)" />
      <arg name="localization_tf_odom_frame" value="$(var localization_tf_odom_frame)" />
      <arg name="localization_tf_base_frame" value="$(var localization_tf_base_frame)" />
      <arg name="localization_tf_publish_rate_hz" value="$(var localization_tf_publish_rate_hz)" />
    </include>
  </group>

  <group if="$(var use_section_localizer)">
    <include file="$(find-pkg-share section_localizer)/launch/section_localizer.launch.xml">
      <arg name="section_localizer_param" value="$(var section_localizer_param)" />
      <arg name="map_yaml_path" value="$(var map_yaml_path)" />
      <arg name="section_definition_path" value="$(var section_definition_path)" />
      <arg name="gate_definition_path" value="$(var gate_definition_path)" />
      <arg name="map_frame" value="$(var section_localizer_map_frame)" />
      <arg name="base_frame" value="$(var section_localizer_base_frame)" />
      <arg name="current_section_topic" value="$(var section_localizer_topic)" />
      <arg name="update_rate_hz" value="$(var section_localizer_update_rate_hz)" />
      <arg name="debug_mode" value="$(var section_localizer_debug_mode)" />
      <arg name="use_sim_time" value="$(var use_sim_time)" />
      <arg name="marker_topic" value="$(var section_localizer_marker_topic)" />
      <arg name="current_marker_topic" value="$(var section_localizer_current_marker_topic)" />
    </include>
  </group>
</launch>

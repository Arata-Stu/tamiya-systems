<launch>

  <arg name="demo" default="false" />
  <arg name="monitor_param" default="$(find-pkg-share system_launch)/config/isaac_ros/greenwave_monitor.param.yaml" />

  <node pkg="greenwave_monitor" 
        exec="greenwave_monitor"
        name="greenwave_monitor"
        output="log">
    <param from="$(var monitor_param)"/>
  </node>

  <!-- テスト時のみ利用 ダミーノード -->
  <group if="$(var demo)">
    <node pkg="greenwave_monitor" exec="minimal_publisher_node" name="minimal_publisher1" output="log">
      <param name="topic" value="imu_topic"/>
      <param name="frequency_hz" value="100.0"/>
    </node>

    <node pkg="greenwave_monitor" exec="minimal_publisher_node" name="minimal_publisher2" output="log">
      <param name="topic" value="image_topic"/>
      <param name="message_type" value="image"/>
      <param name="frequency_hz" value="30.0"/>
    </node>

    <node pkg="greenwave_monitor" exec="minimal_publisher_node" name="minimal_publisher3" output="log">
      <param name="topic" value="string_topic"/>
      <param name="message_type" value="string"/>
      <param name="frequency_hz" value="1000.0"/>
    </node>
  </group>

</launch>
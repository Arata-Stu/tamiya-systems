<launch>
    <arg name="robot_description_xacro" default="$(find-pkg-share jetracer_driver)/urdf/jetracer_sensor_kit.urdf.xacro"/>
    <arg name="base_frame" default="base_link"/>
    <arg name="lidar_frame" default="laser"/>
    <arg name="camera_frame" default="camera_link"/>

    <arg name="lidar_x" default="0.2725"/>
    <arg name="lidar_y" default="0.0"/>
    <arg name="lidar_z" default="0.0257"/>
    <arg name="lidar_roll" default="0.0"/>
    <arg name="lidar_pitch" default="0.0"/>
    <arg name="lidar_yaw" default="0.0"/>

    <arg name="camera_x" default="0.2075"/>
    <arg name="camera_y" default="0.019"/>
    <arg name="camera_z" default="0.065"/>
    <arg name="camera_roll" default="0.0"/>
    <arg name="camera_pitch" default="0.0"/>
    <arg name="camera_yaw" default="0.0"/>
    <arg name="camera_interocular" default="0.05"/>
    <arg name="camera_mount_to_lens_x" default="0.0"/>
    <arg name="camera_mount_to_lens_y" default="-0.0075"/>
    <arg name="camera_mount_to_lens_z" default="0.0"/>
    <arg name="publish_vslam_optical_alias_tf" default="true"/>

    <let
      name="robot_description"
      value="$(command 'xacro $(var robot_description_xacro) base_frame:=$(var base_frame) lidar_frame:=$(var lidar_frame) camera_frame:=$(var camera_frame) lidar_x:=$(var lidar_x) lidar_y:=$(var lidar_y) lidar_z:=$(var lidar_z) lidar_roll:=$(var lidar_roll) lidar_pitch:=$(var lidar_pitch) lidar_yaw:=$(var lidar_yaw) camera_x:=$(var camera_x) camera_y:=$(var camera_y) camera_z:=$(var camera_z) camera_roll:=$(var camera_roll) camera_pitch:=$(var camera_pitch) camera_yaw:=$(var camera_yaw) camera_interocular:=$(var camera_interocular) camera_mount_to_lens_x:=$(var camera_mount_to_lens_x) camera_mount_to_lens_y:=$(var camera_mount_to_lens_y) camera_mount_to_lens_z:=$(var camera_mount_to_lens_z)')"/>

    <node pkg="robot_state_publisher"
          exec="robot_state_publisher"
          name="offline_robot_state_publisher"
          output="screen">
        <param name="robot_description" value="$(var robot_description)"/>
        <param name="use_tf_static" value="true"/>
    </node>

    <node
        if="$(var publish_vslam_optical_alias_tf)"
        pkg="tf2_ros"
        exec="static_transform_publisher"
        name="offline_left_optical_frame_alias"
        args="0 0 0 0 0 0 camera_link_left_optical_frame camera_infra1_optical_frame" />

    <node
        if="$(var publish_vslam_optical_alias_tf)"
        pkg="tf2_ros"
        exec="static_transform_publisher"
        name="offline_right_optical_frame_alias"
        args="0 0 0 0 0 0 camera_link_right_optical_frame camera_infra2_optical_frame" />
</launch>
